derbolt.overrideFloatInDistance":true,"specs.thunderbolt.propsCarmiMappersMigration4":true,"specs.thunderbolt.propsCarmiMappersMigration5":true,"specs.thunderbolt.runMappersWithSpecificDeps":true,"specs.thunderbolt.shouldUseResponsiveImages":true,"specs.thunderbolt.svgResolver_2":true,"specs.thunderbolt.uiTypeNativeMappers":true,"specs.thunderbolt.updateRichTextSemanticClassNamesOnCorvid":true,"specs.thunderbolt.useClassnameInResponsiveAppWidget":true,"specs.thunderbolt.useImageAvifFormatInNativeProGallery":true,"specs.thunderbolt.useResponsiveImgClassicFixed":true,"specs.thunderbolt.useSvgLoaderFeature":true,"specs.thunderbolt.useSvgLoaderFeatureOnBuilderComps":true,"specs.thunderbolt.useWowImageInFastGallery":true},"isClassNameToRootEnabled":true},"comp-lmxe8gky":{"html":"<p class=\"font_9 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.875em; text-align:center;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span class=\"color_15 wixui-rich-text__text\">Le nom de notre association, Teplo (тепло), signifie &laquo;chaleur&raquo; en ukrainien.</span></span></span></p>\n\n<p class=\"font_9 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.875em; text-align:center;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span class=\"color_15 wixui-rich-text__text\">Depuis 2014, les membres du groupe de travail, devenu plus tard le noyau de l&#39;association Teplo, ont particip&eacute; activement &agrave; des activit&eacute;s en faveur de l&#39;Ukraine : ils ont fourni une aide humanitaire, organis&eacute; des &eacute;v&eacute;nements culturels comme une exposition de photographies de Reuters et une conf&eacute;rence contre la guerre (Arles, France, 2014).<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nDepuis le printemps 2022 Teplo a adapt&eacute; son soutien &agrave; l&rsquo;Ukraine :<br class=\"wixui-rich-text__text\">\nen r&eacute;ponse aux d&eacute;fis qui mena&ccedil;aient la vie de plusieurs milliers de personnes et la civilisation elle-m&ecirc;me, s&rsquo;est officiellement enregistr&eacute;e comme association Loi 1901. Elle a ainsi rejoint le mouvement paneurop&eacute;en d&#39;aide aux r&eacute;fugi&eacute;s ukrainiens.<br class=\"wixui-rich-text__text\">\nEn plus de mise &agrave; disposition de traducteurs b&eacute;n&eacute;voles, d&#39;avocats et de psychologues, Teplo a commenc&eacute; &agrave; d&eacute;velopper de nouveaux formats de soutien psychologique, efficace et accessible &agrave; toutes les victimes, tout en contribuant &agrave; formaliser les demandes des victimes du SSP</span></span></span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span class=\"color_15 wixui-rich-text__text\">T (syndrome de stress post-traumatique).<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nDans la nouvelle r&eacute;alit&eacute;, le nombre de personnes subissant de lourdes pertes et ayant besoin d&rsquo;aide, notamment d&rsquo;un soutien psychologique, augmente de fa&ccedil;on exponentielle et les syst&egrave;mes de soutien existants deviennent de moins en moins accessibles en raison du nombre de r&eacute;fugi&eacute;s.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nLa premi&egrave;re &eacute;tape du travail de l&rsquo;association a constitu&eacute; principalement &agrave; mettre en place des activit&eacute;s visant &agrave; aider les enfants r&eacute;fugi&eacute;s ukrainiens : les plus sans d&eacute;fense parmi les victimes des conflits militaires. Cela signifie un soutien psychoth&eacute;rapeutique apport&eacute; aux membres de leur famille, tant &agrave; ceux qui sont qui sont d&eacute;j&agrave; en Europe qu&rsquo;&agrave; ceux qui restent en Ukraine. Un soutien psychologique sans lequel le r&eacute;tablissement ult&eacute;rieur de l&rsquo;&eacute;quilibre interne des enfants est impossible.</span></span></span></p>\n\n<p class=\"font_9 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.875em; text-align:center;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span class=\"color_15 wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span></span></span></span></p>\n\n<p class=\"font_9 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.875em; text-align:center;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"letter-spacing:normal;\" class=\"wixui-rich-text__text\"><span class=\"color_15 wixui-rich-text__text\"><span class=\"wixGuard wixui-rich-text__text\">​</span>Si au d&eacute;part, le centre de nos efforts &eacute;tait l&rsquo;Ukraine, ces derniers temps notre intention de coop&eacute;rer avec les sp&eacute;cialistes du l&rsquo;Association libanaise de psychoth&eacute;rapie et avec ce groupe de psychoth&eacute;rapeutes isra&eacute;liens, qui ont particip&eacute; &agrave; la conf&eacute;rence d&rsquo;&eacute;change de pratiques en 2022, a acquis une importance particuli&egrave;re</span></span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"pageBackground_ufxvg":{"fillLayers":{"containerId":"pageBackground_ufxvg","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"backgroundOverlay":{},"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"ufxvg":{"className":"theme-vars"},"comp-lmxe8ghl":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lmxe8ghl","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"