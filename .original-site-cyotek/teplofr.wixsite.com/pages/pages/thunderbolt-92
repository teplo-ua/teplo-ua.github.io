{"stateRefs":{"comp-m2b0vtlx":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-m2b0vtm21":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-m2b0vtm9":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-m2b0vtlu":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-m2b0vtm52":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}}},"structure":{"components":{"comp-m2b0vtlx":{"componentType":"WRichText","pageId":"v81u2"},"comp-m2b0vtm21":{"componentType":"WRichText","pageId":"v81u2"},"comp-m2b0vtm9":{"componentType":"WRichText","pageId":"v81u2"},"pageBackground_v81u2":{"componentType":"PageBackground","pageId":"masterPage"},"v81u2":{"components":["Containerv81u2"],"componentType":"Page","uiType":"TransparentPageSkin","pageId":"v81u2"},"comp-m2b0vtlu":{"components":["comp-m2b0vtlx","comp-m2b0vtm21"],"componentType":"ClassicSection","pageId":"v81u2"},"comp-m2b0vtm52":{"components":["comp-m2b0vtm9"],"componentType":"ClassicSection","pageId":"v81u2"},"Containerv81u2":{"components":["comp-m2b0vtlu","comp-m2b0vtm52"],"componentType":"Group","pageId":"v81u2"}},"features":["accessibilityBrowserZoom","clickHandlerRegistrar","components","domSelectors","environmentService","imagePlaceholder","landingPage","mpaNavigation","navigationManager","pageAnchors","pageTransitions","renderer","reporter","scrollRestoration","scrollToAnchor","seo","windowScroll","wixEmbedsApi"],"siteFeaturesConfigs":null},"props":{"render":{"compProps":{"comp-m2b0vtlx":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:50px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:50px;\" class=\"wixui-rich-text__text\">Jardins therapeutiques</span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m2b0vtm21":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.8em;\">Les jardins th&eacute;rapeutiques sont une forme d&#39;organisation de l&#39;espace sous forme de paysage et de parc d&eacute;velopp&eacute;e dans le cadre du concept d&#39;Evidence-Based Design In Healthcare.</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m2b0vtm9":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:times new roman,times,serif;\" class=\"wixui-rich-text__text\">Ce concept existe depuis 40 ans, depuis 1984. Son initiateur est <span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Roger Stephen Ulrich</span> travaillait alors &agrave; l&#39;Universit&eacute; du Delaware.<br class=\"wixui-rich-text__text\">\nDepuis lors, il a &eacute;t&eacute; scientifiquement prouv&eacute; que le fait de se trouver dans certains paysages naturels (ou m&ecirc;me de les contempler) a un effet positif sur la rapidit&eacute; et la qualit&eacute; du r&eacute;tablissement des patients souffrant de l&eacute;sions organiques et de traumatismes psychophysiologiques (par exemple, le syndrome de stress post-traumatique).<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nLe jardin th&eacute;rapeutique est une r&eacute;alisation moderne de ce concept : un environnement paysager sp&eacute;cialement am&eacute;nag&eacute; et zon&eacute;, con&ccedil;u pour que les th&eacute;rapeutes et les psychoth&eacute;rapeutes puissent travailler avec les patients (individuellement et en groupe) selon l&#39;un des protocoles existants de ce type de travail.<br class=\"wixui-rich-text__text\">\nIl existe de nombreux travaux sur l&#39;efficacit&eacute; d&#39;une telle technique dans la th&eacute;rapie de divers troubles, y compris les troubles psychiatriques.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nL&#39;&eacute;volution de la situation d&#39;un paysage de jardin standard vers une th&eacute;rapie dans des jardins sp&eacute;cialement con&ccedil;us est analogue &agrave; la transformation de la th&eacute;rapie par l&#39;eau et la boue, qui est pass&eacute;e d&#39;un loisir sp&eacute;culatif &agrave; un traitement professionnel en baln&eacute;ologie et en sanatorium dans le cadre d&#39;une m&eacute;decine fond&eacute;e sur des donn&eacute;es probantes.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nLes param&egrave;tres optimaux d&#39;un jardin th&eacute;rapeutique sont une superficie d&#39;environ 1 &agrave; 2 hectares, une division en 8 zones fonctionnelles, un cheminement ais&eacute; dans le jardin, la pr&eacute;sence d&#39;objets hydrologiques (miroir d&#39;eau).<br class=\"wixui-rich-text__text\">\nEn m&ecirc;me temps, les param&egrave;tres peuvent &ecirc;tre adapt&eacute;s de mani&egrave;re flexible aux particularit&eacute;s de l&#39;endroit :</span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\">\n<li style=\"line-height:1.75em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\">la surface peut commencer &agrave; 200-300 m&egrave;tres carr&eacute;s,</p>\n</li>\n<li style=\"line-height:1.75em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:times new roman,times,serif;\" class=\"wixui-rich-text__text\">le nombre de zones peut &ecirc;tre r&eacute;duit</span></span></p>\n</li>\n<li style=\"line-height:1.75em;\" class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:times new roman,times,serif;\" class=\"wixui-rich-text__text\">les plans d&#39;eau sont facultatifs (mais il est souhaitable qu&#39;il y ait au moins un petit volume d&#39;eau artificiel).</span></span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.75em;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-family:times new roman,times,serif;\" class=\"wixui-rich-text__text\">Les jardins peuvent &ecirc;tre constitu&eacute;s de cultures provenant de diff&eacute;rentes zones g&eacute;ographiques et &eacute;cologiques, &agrave; condition qu&#39;elles puissent remplir une zone avec des param&egrave;tres donn&eacute;s (zone publique ou isol&eacute;e, paysage ouvert ou plantation relativement dense et ombrag&eacute;e, etc.)<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nLe concept des terrasses a &eacute;t&eacute; le plus d&eacute;velopp&eacute; dans les pays de la &laquo; civilisation nordique &raquo; (Angleterre, Hollande, Allemagne, Scandinavie, Am&eacute;rique du Nord), mais il est pertinent pour n&#39;importe quelle r&eacute;gion de la Terre.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nL&#39;&eacute;tat moderne de la civilisation, avec son hyper-urbanisation, son hypodynamie, sa virtualisation et ses probl&egrave;mes de stabilit&eacute; mondiale, a marqu&eacute; un besoin fortement croissant de m&eacute;thodes efficaces de compensation et de th&eacute;rapie des effets psychologiques n&eacute;gatifs, des traumatismes, des cons&eacute;quences d&#39;&eacute;v&eacute;nements destructeurs, dont le nombre ne cesse de cro&icirc;tre.<br class=\"wixui-rich-text__text\">\n<br class=\"wixui-rich-text__text\">\nLa guerre en Europe a rendu ce besoin catastrophique. L&#39;association Teplo se consacre &agrave; l&#39;aide aux victimes de la guerre, en commen&ccedil;ant par l&#39;agression de la F&eacute;d&eacute;ration de Russie en Ukraine et en continuant avec d&#39;autres conflits, dont le nombre ne cesse de cro&icirc;tre.</span></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"pageBackground_v81u2":{"fillLayers":{"containerId":"pageBackground_v81u2","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"backgroundOverlay":{},"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"v81u2":{"className":"theme-vars"},"comp-m2b0vtlu":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m2b0vtlu","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"comp-m2b0vtm52":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-m2b0vtm52","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"Containerv81u2":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}}}},"__componentsConfig__":{},"accessibilityBrowserZoom":{"isBuilder":false,"isStudio":false},"components":{"componentsUnderFoldMap":{}},"domSelectors":{"allComponentIds":["comp-m2b0vtlx","comp-m2b0vtm21","comp-m2b0vtm9","pageBackground_v81u2","v81u2","comp-m2b0vtlu","comp-m2b0vtm52","Containerv81u2"]},"imagePlaceholder":{"staticMediaUrl":"https://static.wixstatic.com/media","isSEOBot":false},"landingPage":{"isLandingPage":false},"pageAnchors":{"anchors":[{"data