{"stateRefs":{"comp-lsy2a6st":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-lsy2a6t5":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-m2kza88p":{"reportBi":{"$type":"ref","refPath":["exports","businessLogger","reportBi"]},"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-lsy2a6tc":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-lsy2a6s5":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}},"comp-lsy2a6t9":{"experiments":{"$type":"ref","refPath":["exports","environment","experiments"]}}},"structure":{"components":{"comp-lsy2a6st":{"componentType":"WRichText","pageId":"pd6tg"},"comp-lsy2a6t5":{"componentType":"WRichText","pageId":"pd6tg"},"comp-m2kza88p":{"componentType":"WPhoto","uiType":"NoSkinPhoto","pageId":"pd6tg"},"comp-lsy2a6tc":{"componentType":"WRichText","pageId":"pd6tg"},"pageBackground_pd6tg":{"componentType":"PageBackground","pageId":"masterPage"},"pd6tg":{"components":["Containerpd6tg"],"componentType":"Page","uiType":"TransparentPageSkin","pageId":"pd6tg"},"comp-lsy2a6s5":{"components":["comp-lsy2a6st","comp-lsy2a6t5"],"componentType":"ClassicSection","pageId":"pd6tg"},"comp-lsy2a6t9":{"components":["comp-m2kza88p","comp-lsy2a6tc"],"componentType":"ClassicSection","pageId":"pd6tg"},"Containerpd6tg":{"components":["comp-lsy2a6s5","comp-lsy2a6t9"],"componentType":"Group","pageId":"pd6tg"}},"features":["accessibilityBrowserZoom","clickHandlerRegistrar","components","domSelectors","environmentService","imagePlaceholder","landingPage","mpaNavigation","navigationManager","pageAnchors","pageTransitions","renderer","reporter","scrollRestoration","scrollToAnchor","seo","windowScroll","wixEmbedsApi"],"siteFeaturesConfigs":null},"props":{"render":{"compProps":{"comp-lsy2a6st":{"html":"<h1 class=\"font_0 wixui-rich-text__text\" style=\"font-size:50px;\"><span style=\"font-size:30px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Projet de La Plateforme D&#39;Aide Psychoth&eacute;rapeutique Actuelle</span></span><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:50px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Help To Help !</span></span></h1>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-lsy2a6t5":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px; line-height:1.8em; text-align:justify;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">L&#39;association <span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Te</span></span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">plo </span>travaille depuis 2022 dans le domaine de l&#39;aide psychologique aux enfants</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">touch&eacute;s par la guerre et &agrave; leurs proches.</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"> Pendant les deux ann&eacute;es de la grande guerre, les membres praticiens de l&#39;association et leurs</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">coll&egrave;gues ont accumul&eacute; une exp&eacute;rience consid&eacute;rable et, &agrave; bien des &eacute;gards, unique en mati&egrave;re d&#39;aide</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">psychologique dans des conditions de besoin massif et &agrave; long terme, y compris dans la zone de re-</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">traumatisation constante et de s&eacute;jour dangereux (actuellement l&#39;ensemble du territoire de l&#39;Ukraine).</span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"comp-m2kza88p":{"uri":"946bd9_380347b460fe4332a2791af2406ae155~mv2.jpg","alt":"toa-heftiba-_UIVmIBB3JU-unsplash.jpg","width":1920,"height":1280,"name":"toa-heftiba-_UIVmIBB3JU-unsplash.jpg","containerId":"comp-m2kza88p","hasBgScrollEffect":"","bgEffectName":"","displayMode":"fill","link":{},"hasAnimation":false,"encoding":"AVIF","responsiveImageProps":{"fallbackSrc":"https://static.wixstatic.com/media/946bd9_380347b460fe4332a2791af2406ae155~mv2.jpg/v1/fill/w_924,h_616,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/toa-heftiba-_UIVmIBB3JU-unsplash.jpg","srcset":"https://static.wixstatic.com/media/946bd9_380347b460fe4332a2791af2406ae155~mv2.jpg/v1/fill/w_924,h_616,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/toa-heftiba-_UIVmIBB3JU-unsplash.jpg 1x, https://static.wixstatic.com/media/946bd9_380347b460fe4332a2791af2406ae155~mv2.jpg/v1/fill/w_1848,h_1232,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/toa-heftiba-_UIVmIBB3JU-unsplash.jpg 2x","css":{"container":{"position":"relative"},"img":{"width":924,"height":616,"objectFit":"cover"}}},"containerWidth":924,"containerHeight":616,"isInFirstFold":true,"crop":null,"onClickBehavior":"goToLink","fullNameCompType":"wysiwyg.viewer.components.WPhoto","language":"fr","compId":"comp-m2kza88p","mainPageId":"dt6xi","trackClicksAnalytics":false,"popupA11yExperimentEnabled":false,"translations":{"expandAriaLabel":"Agrandir l'image","zoomInButtonAriaLabel":"Zoom in"},"zoomedImageResponsiveOverride":{},"allowFullGIFTransformation":false},"comp-lsy2a6tc":{"html":"<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Nouveaut&eacute; et importance du projet :</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Tous les protocoles de soins psychoth&eacute;rapeutiques modernes ont &eacute;t&eacute; cr&eacute;&eacute;s relativement r&eacute;cemment - la psychoth&eacute;rapie en tant que discipline scientifique et pratique de masse, et en tant que branche puissante du soutien socio-m&eacute;dical, a &eacute;t&eacute; cr&eacute;&eacute;e dans la seconde moiti&eacute; du 20&egrave;me si&egrave;cle, &agrave; l&#39;&eacute;poque de la &quot;grande paix&quot;, qui est apparue dans les pays occidentaux/de la &quot;civilisation occidentale&quot; apr&egrave;s la fin de la Seconde Guerre mondiale.<br class=\"wixui-rich-text__text\">\nL&#39;un des principes de base de la psychoth&eacute;rapie &eacute;tait le principe de son inapplicabilit&eacute; lorsque le patient se trouve dans un environnement instable et dangereux, avec le risque d&#39;une re-traumatisation au cours de la th&eacute;rapie.<br class=\"wixui-rich-text__text\">\nLes &eacute;v&eacute;nements de ces deux derni&egrave;res ann&eacute;es ont clairement d&eacute;montr&eacute; la r&eacute;alit&eacute; du sc&eacute;nario d&#39;un impact catastrophique destructeur &agrave; tr&egrave;s long terme, entra&icirc;nant un grand nombre de victimes et un flux continu de personnes atteintes de psychotraumatismes, qui ont besoin d&#39;une assistance urgente et massive.<br class=\"wixui-rich-text__text\">\nL&#39;exp&eacute;rience de cette aide en Ukraine en 2022-2024 est unique, non seulement en raison de la demande extr&ecirc;mement massive de soutien th&eacute;rapeutique, mais aussi parce qu&#39;il est pratiquement impossible d&#39;observer le principe susmentionn&eacute; : il n&#39;y a pratiquement pas de territoires s&ucirc;rs dans tout le pays et, en outre, les psychoth&eacute;rapeutes eux-m&ecirc;mes (qui m&egrave;nent directement la th&eacute;rapie ou la supervisent) se trouvent dans une atmosph&egrave;re psychologiquement instable (la plupart d&#39;entre eux ont des parents qui sont ou ont &eacute;t&eacute; impliqu&eacute;s dans les hostilit&eacute;s, ou ont le statut de personnes d&eacute;plac&eacute;es, de r&eacute;fugi&eacute;s en Ukraine m&ecirc;me et dans d&#39;autres pays).<br class=\"wixui-rich-text__text\">\nAinsi, les protocoles de temps de paix pour l&#39;Ukraine ne sont plus pertinents, m&ecirc;me au moment de l&#39;entr&eacute;e en th&eacute;rapie : selon les protocoles internationaux existants, il est impossible de commencer &agrave; fournir de l&#39;aide &agrave; la grande majorit&eacute; de ceux qui en ont besoin.<br class=\"wixui-rich-text__text\">\nDans ces conditions, l&#39;exp&eacute;rience des sp&eacute;cialistes ukrainiens, accumul&eacute;e et partiellement syst&eacute;matis&eacute;e depuis deux ans, montre qu&#39;il est possible d&#39;enfreindre ce principe, c&#39;est-&agrave;-dire de commencer la th&eacute;rapie dans des conditions non stabilis&eacute;es ! Dans ce cas, l&#39;assistance reste (totalement ou partiellement) efficace, efficiente, et la pr&eacute;sence d&#39;une telle assistance, m&ecirc;me dans des conditions sous-optimales, am&eacute;liore consid&eacute;rablement le pronostic et l&#39;&eacute;tat des patients par rapport &agrave; la situation o&ugrave; l&#39;on ne fournit pas d&#39;assistance, ou bien o&ugrave; on la reporte jusqu&#39;&agrave; ce que les conditions n&eacute;cessaires apparaissent.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Perspectives :</span></span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Le nombre croissant de conflits arm&eacute;s et paramilitaires graves dans le monde (Moyen-Orient, Asie centrale, Am&eacute;rique latine, Extr&ecirc;me-Orient, escalade possible en Europe) menace d&#39;entra&icirc;ner une augmentation, comparable &agrave; une avalanche, du nombre de personnes ayant subi de graves traumatismes psychologiques et de la demande de soutien psychoth&eacute;rapeutique professionnel d&#39;urgence.<br class=\"wixui-rich-text__text\">\nL&#39;&eacute;tude, la syst&eacute;matisation, la reproduction et la v&eacute;rification de l&#39;exp&eacute;rience ukrainienne pourraient non seulement &ecirc;tre tr&egrave;s utiles dans ces conditions &agrave; ceux &agrave; qui cette aide est directement destin&eacute;e, mais aussi - si la communaut&eacute; th&eacute;rapeutique et scientifique internationale confirme la justesse des conclusions obtenues en ces jours difficiles- conduire &agrave; la r&eacute;vision et &agrave; l&#39;am&eacute;lioration des protocoles standard d&#39;aide psychoth&eacute;rapeutique et d&#39;autres types d&#39;aide connexes en vue d&#39;une utilisation plus efficace, y compris en temps de paix.<br class=\"wixui-rich-text__text\">\nEn adoptant cette perspective, nous tenons compte du fait que, m&ecirc;me dans des environnements totalement pacifiques, la demande de soutien psychoth&eacute;rapeutique a augment&eacute; &agrave; un rythme important au cours des derni&egrave;res d&eacute;cennies. Nous nous souvenons tous, par exemple, de la r&eacute;cente pand&eacute;mie de coronavirus, qui a mis &agrave; rude &eacute;preuve le bien-&ecirc;tre mental des gens.<br class=\"wixui-rich-text__text\">\nEt au fur et &agrave; mesure que les progr&egrave;s de la civilisation s&#39;&eacute;tendent &agrave; de nouvelles r&eacute;gions et de nouveaux pays, la psychoth&eacute;rapie peut &eacute;videmment devenir l&#39;une des disciplines socio-m&eacute;dicales les plus recherch&eacute;es, &agrave; la fois par les patients et par les professionnels.<br class=\"wixui-rich-text__text\">\nAinsi, la n&eacute;cessit&eacute; d&#39;une mise en &oelig;uvre plus massive et plus rapide du soutien psychoth&eacute;rapeutique semble en tout cas &ecirc;tre une r&eacute;alit&eacute; du futur proche, et elle n&eacute;cessitera &agrave; la fois des protocoles optimis&eacute;s et des techniques innovantes pour ce soutien.<br class=\"wixui-rich-text__text\">\nLa situation actuelle en Ukraine, ainsi que dans d&#39;autres pays, offre la possibilit&eacute; d&#39;un effort coordonn&eacute; &agrave; grande &eacute;chelle pour d&eacute;velopper les deux, identifier les plus efficaces, syst&eacute;matiser les connaissances fond&eacute;es sur la m&eacute;thode scientifique et la m&eacute;decine factuelle, et &eacute;tendre rapidement les nouvelles pratiques en vue d&#39;une application efficace &agrave; l&#39;&eacute;chelle mondiale.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ce qu&#39;il faut pour cela :</span></span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">L&#39;exp&eacute;rience acquise par la communaut&eacute; psychoth&eacute;rapeutique ukrainienne doit &ecirc;tre &eacute;tudi&eacute;e, syst&eacute;matis&eacute;e et reproduite &agrave; plusieurs reprises dans diff&eacute;rents pays et soci&eacute;t&eacute;s de la plan&egrave;te. De cette mani&egrave;re, il est possible non seulement de confirmer, d&#39;affiner et de d&eacute;velopper les hypoth&egrave;ses et les conclusions des sp&eacute;cialistes ukrainiens et de leurs coll&egrave;gues qui travaillent d&eacute;j&agrave; avec eux, mais aussi d&#39;am&eacute;liorer de mani&egrave;re centrale les soins apport&eacute;s aux patients d&eacute;j&agrave; disponibles et &agrave; ceux qui pourraient appara&icirc;tre dans un avenir tr&egrave;s proche.<br class=\"wixui-rich-text__text\">\nNous savons comment la recherche dans les domaines de la virologie, de la biologie mol&eacute;culaire et de l&#39;&eacute;pid&eacute;miologie, fortement intensifi&eacute;e avec l&#39;apparition de la pand&eacute;mie de COVID-19, a conduit &agrave; une&nbsp; avanc&eacute;e scientifique et technologique majeure dans ces domaines, &agrave; la cr&eacute;ation et &agrave; l&#39;exp&eacute;rimentation, non seulement de moyens de lutte contre le nouveau virus, mais aussi contre une vari&eacute;t&eacute; d&#39;infections graves depuis longtemps famili&egrave;res &agrave; l&#39;humanit&eacute;.<br class=\"wixui-rich-text__text\">\nNous nous souvenons qu&#39;une avanc&eacute;e similaire s&#39;est produite dans le monde apr&egrave;s les pand&eacute;mies de grippe de 1957-1958 et de 1968-1969 - c&#39;est alors que la virologie mondiale moderne a &eacute;t&eacute; cr&eacute;&eacute;e en tant que branche capable de contr&ocirc;ler et de vaincre des maladies qui tuaient de nombreuses personnes depuis des si&egrave;cles.<br class=\"wixui-rich-text__text\">\nLa situation actuelle est peut-&ecirc;tre encore plus tragique que les &eacute;pid&eacute;mies mondiales et, en tant que source de cons&eacute;quences catastrophiques, elle fournit &eacute;galement un mat&eacute;riel d&#39;une ampleur sans pr&eacute;c&eacute;dent pour le d&eacute;veloppement de moyens et de principes existants et nouveaux de traitement, et d&#39;accompagnement des personnes dans un autre domaine, celui de la psychologie.<br class=\"wixui-rich-text__text\">\nLe lancement d&#39;un travail commun des &eacute;coles th&eacute;rapeutiques et scientifiques mondiales sur le probl&egrave;me du soutien th&eacute;rapeutique de masse d&#39;urgence pour les personnes souffrant de psychotraumatismes caus&eacute;s par des &eacute;v&eacute;nements catastrophiques - bas&eacute; sur l&#39;exp&eacute;rience, les innovations et les r&eacute;alisations acquises par les sp&eacute;cialistes ukrainiens dans les conditions d&#39;invasion agressive - permettra d&#39;adapter les protocoles classiques d&#39;assistance psychoth&eacute;rapeutique aux nouveaux d&eacute;fis de la r&eacute;alit&eacute; moderne. R&eacute;alit&eacute; qui exige de la part de la m&eacute;decine mondiale et des services sociaux des changements s&eacute;rieux et rapides, correspondant aux exigences de la situation actuelle de l&#39;Ukraine.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ce dont nous disposons :</span></span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">L&#39;association Warmth est compos&eacute;e de praticiens qui travaillent depuis deux ans en premi&egrave;re ligne dans le domaine de l&#39;aide psychoth&eacute;rapeutique d&#39;urgence, tant en Ukraine qu&#39;avec les citoyens ukrainiens dans les pays europ&eacute;ens. Ils ont d&eacute;j&agrave; acquis une grande exp&eacute;rience du travail r&eacute;ussi dans les conditions les plus ardues avec des patients extr&ecirc;mement difficiles.<br class=\"wixui-rich-text__text\">\nDans le cadre de l&#39;association en 2022, la recherche de formes et de m&eacute;thodes de travail nouvelles ou adapt&eacute;es pour travailler dans les conditions dans lesquelles se trouvent de nombreux Ukrainiens - r&eacute;fugi&eacute;s, personnes d&eacute;plac&eacute;es dans des pays &eacute;trangers, un besoin &eacute;norme d&#39;aide psychoth&eacute;rapeutique avec une p&eacute;nurie &eacute;vidente de sp&eacute;cialistes.<br class=\"wixui-rich-text__text\">\nCertaines formes innovantes d&#39;assistance ont &eacute;t&eacute; test&eacute;es dans le cadre d&eacute;v&eacute;nements organis&eacute;s par l&#39;association Warmth.<br class=\"wixui-rich-text__text\">\nUn processus d&#39;&eacute;changes professionnels informatifs entre th&eacute;rapeutes de diff&eacute;rents pays a &eacute;galement &eacute;t&eacute; lanc&eacute;. Une conf&eacute;rence pratique pour les art-th&eacute;rapeutes a eu lieu en ao&ucirc;t 2022 dans la r&eacute;gion de La Salvetat-sur-Agout, avec des th&eacute;rapeutes de France, d&#39;Ukraine, du Liban, d&#39;Isra&euml;l et d&#39;Alg&eacute;rie participant &agrave; une r&eacute;sidence artistique.<br class=\"wixui-rich-text__text\">\nNous continuons &agrave; rechercher de nouvelles opportunit&eacute;s pour aider les r&eacute;fugi&eacute;s les plus vuln&eacute;rables souffrant de troubles traumatiques - les enfants, en particulier les enfants pr&eacute;sentant certaines caract&eacute;ristiques ou d&eacute;ficiences, et leurs proches.<br class=\"wixui-rich-text__text\">\nActuellement, l&#39;association organise et communique activement sur la mise en &oelig;uvre de projets tels que la plantation d&#39;arboretums comm&eacute;moratifs par des enfants et des adolescents ayant des parents d&eacute;c&eacute;d&eacute;s, et travaille &agrave; la cr&eacute;ation et &agrave; l&#39;utilisation de jardins th&eacute;rapeutiques. Malheureusement, nous manquons souvent de ressources, qu&#39;elles soient mat&eacute;rielles, humaines ou professionnelles.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Nos objectifs et notre vision :</span></span></span><br class=\"wixui-rich-text__text\">\n&nbsp;</p>\n\n<ol class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nous consid&eacute;rons qu&#39;il est n&eacute;cessaire d&#39;apporter une aide efficace et urgente aux victimes les plus</span><span class=\"inherit-font-size wixui-rich-text__text\" style=\"font-size:18px;\"> </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">f</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">aibles et les plus traumatis&eacute;es de la guerre/ l&#39;agression en Ukraine et que ce besoin risque de s&#39;accro&icirc;tre, compte tenu de l&#39;&eacute;volution de la situation en Europe et ailleurs dans le monde.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nous consacrons notre &eacute;nergie &agrave; fournir cette aide, mais en m&ecirc;me temps nous voyons la n&eacute;cessit&eacute; </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">d&#39;aider ceux qui fournissent cette aide, parce que la demande est beaucoup plus grande que les </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">ressources disponibles dans le paradigme de la psychoth&eacute;rapie en temps de paix.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nous recherchons des solutions efficaces et innovantes pour aider davantage de survivants et, en </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">m&ecirc;me temps, nous essayons de d&eacute;velopper de nouvelles pratiques et de g&eacute;n&eacute;raliser notre </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">exp&eacute;rience, de la partager avec nos coll&egrave;gues et d&#39;organiser de nouveaux canaux pour cet &eacute;change </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">d&#39;exp&eacute;rience, l&#39;apprentissage &agrave; partir de l&#39;exp&eacute;rience, avec le d&eacute;veloppement &eacute;ventuel de protocoles </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">psychoth&eacute;rapeutiques nouveaux ou &eacute;largis.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nous visons &agrave; diffuser notre exp&eacute;rience dans les pays d&#39;accueil des r&eacute;fugi&eacute;s d&#39;Ukraine (et </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&eacute;ventuellement d&#39;autres pays), &agrave; former des liens communautaires horizontaux, &agrave; &eacute;tendre le r&eacute;seau </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">d&#39;activit&eacute;s th&eacute;rapeutiques, de soutien et d&#39;accompagnement dans des r&eacute;gions nouvelles et </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&eacute;mergentes du continent.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nous pr&eacute;voyons de cr&eacute;er et de maintenir une plateforme d&#39;information couvrant les </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">questions identifi&eacute;es et aidant les professionnels de diff&eacute;rents domaines, impliqu&eacute;s dans toutes les </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">activit&eacute;s qui aident &agrave; r&eacute;soudre les probl&egrave;mes de soutien psychologique et social des personnes qui en</span><span class=\"inherit-font-size wixui-rich-text__text\" style=\"font-size:18px;\"> </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">o</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">nt besoin, &agrave; communiquer les uns avec les autres</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">.</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Ainsi, nous formons une plateforme sur le principe de &quot;<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">l&#39;aide &agrave; l&#39;aide</span>&quot; (<span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Help to help </span>- eng.), op&eacute;rant dans les </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">diff&eacute;rents domaines de la vie sociale pour r&eacute;soudre le probl&egrave;me principal - fournir un soutien aux</span><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">victimes dans des situations catastrophiques (conflits militaires, conflits politiques, catastrophes</span><span class=\"inherit-font-size wixui-rich-text__text\" style=\"font-size:18px;\"> </span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">n</span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">aturelles)</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Finalement, notre exp&eacute;rience devrait faire partie des normes quotidiennes d&#39;assistance mises</span><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&agrave; jour dans le monde entier.</span></p>\n</li>\n</ol>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span class=\"inherit-font-size wixui-rich-text__text\" style=\"font-size:21px;\"><span class=\"wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-style:italic;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Qui sont nos partenaires ?</span></span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Nos professionnels collaborent d&eacute;j&agrave; activement avec des <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">coll&egrave;gues de la communaut&eacute; psychoth&eacute;rapeutique en Europe</span>, et nous envisageons d&#39;&eacute;tendre cette collaboration &agrave; de nouveaux niveaux de signification et d&#39;organisation. Pour cela, nous avons bien s&ucirc;r besoin d&#39;un mouvement vers nous, non seulement de la part de la communaut&eacute; professionnelle internationale, mais aussi de la part des institutions sociales, publiques et &eacute;tatiques, en particulier des pays d&#39;Europe et de l&#39;Union europ&eacute;enne dans son ensemble.<br class=\"wixui-rich-text__text\">\nNous sommes dispos&eacute;s et pr&ecirc;ts &agrave; coop&eacute;rer avec <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">les repr&eacute;sentants des autorit&eacute;s &agrave; diff&eacute;rents niveaux dans les pays </span>et les r&eacute;gions o&ugrave; se trouvent (et continueront &agrave; se trouver) des r&eacute;fugi&eacute;s d&#39;Ukraine et d&#39;autres points chauds et probl&eacute;matiques de la plan&egrave;te.<br class=\"wixui-rich-text__text\">\nLes premiers fruits de cette coop&eacute;ration ont d&eacute;j&agrave; pouss&eacute; en France, en particulier dans la r&eacute;gion de La Salvetat-sur-Agout en Occitanie, o&ugrave; des &eacute;v&eacute;nements Warmth ont d&eacute;j&agrave; eu lieu avec le soutien des autorit&eacute;s r&eacute;gionales.<br class=\"wixui-rich-text__text\">\nNous souhaitons &eacute;tendre la g&eacute;ographie de ces &eacute;v&eacute;nements non seulement &agrave; l&#39;ensemble du territoire fran&ccedil;ais, mais aussi &agrave; tous les pays de l&#39;Union europ&eacute;enne qui accueillent des personnes d&eacute;plac&eacute;es &agrave; l&#39;int&eacute;rieur de zones de guerre.<br class=\"wixui-rich-text__text\">\nNous sommes &eacute;galement pr&ecirc;ts &agrave; coop&eacute;rer avec des <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">repr&eacute;sentants du monde des affaires</span>, &agrave; offrir des solutions qui peuvent &ecirc;tre utiles &agrave; la r&eacute;habilitation des personnes qui ont subi de graves traumatismes psychologiques - qu&#39;il s&#39;agisse d&#39;entreprises informatiques d&eacute;veloppant du mat&eacute;riel et des logiciels susceptibles d&rsquo;aider &agrave; la r&eacute;habilitation et &agrave; l&#39;adaptation des r&eacute;fugi&eacute;s dans des conditions nouvelles et inhabituelles, de fabricants de produits alimentaires et pharmaceutiques qui ont un impact positif sur l&#39;&eacute;tat des personnes en th&eacute;rapie, ou de toute autre entreprise pr&ecirc;te &agrave; participer d&#39;une mani&egrave;re ou d&#39;une autre &agrave; l&#39;appui du projet et de ses b&eacute;n&eacute;ficiaires.<br class=\"wixui-rich-text__text\">\nNous avons besoin du soutien des m&eacute;dias et des <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">professionnels des m&eacute;dias </span>qui sont pr&ecirc;ts</span><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\"> :</span></p>\n\n<ul class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\">\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&agrave; couvrir, de mani&egrave;re r&eacute;fl&eacute;chie et int&eacute;ress&eacute;e, les questions auxquelles notre projet est consacr&eacute;</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&agrave; sensibiliser toutes les parties int&eacute;ress&eacute;es aux questions de soutien psychoth&eacute;rapeutique moderne, en particulier d&#39;urgence</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&agrave; nous aider &agrave; &eacute;tendre le r&eacute;seau de liens horizontaux</span></p>\n</li>\n<li class=\"wixui-rich-text__text\">\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">&agrave; trouver de nouveaux participants et partenaires pour aider ceux qui ont besoin d&#39;une telle aide</span><br class=\"wixui-rich-text__text\">\n<span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">aujourd&#39;hui.</span></p>\n</li>\n</ul>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\">Bien entendu, nous sommes tr&egrave;s int&eacute;ress&eacute;s par la participation et le soutien de personnalit&eacute;s publiques et politiques, de ceux qui sont les leaders de l&#39;opinion publique, qui fa&ccedil;onnent la politique des pays dans des questions - priv&eacute;es et pratiques d&#39;une part, mais tr&egrave;s importantes pour l&#39;avenir de l&#39;ensemble de la soci&eacute;t&eacute; civile d&#39;autre part - telles que l&#39;am&eacute;lioration des m&eacute;canismes de fourniture d&#39;une assistance psychologique &agrave; tous ceux qui en ont cruellement besoin.<br class=\"wixui-rich-text__text\">\nNous sommes convaincus que l&#39;Association europ&eacute;enne des <span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">ancie</span></span><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">ns parlementaires </span>des &Eacute;tats/pays membres du Conseil de l&rsquo;Europe (FP-AP) deviendra l&#39;un de nos partenaires les plus importants dans l&#39;entreprise &agrave; laquelle nous avons consacr&eacute; pratiquement toute notre vie au cours des deux derni&egrave;res ann&eacute;es.</span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:21px;\"><span style=\"font-size:21px;\" class=\"wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​</span></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Photo &copy; <span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Iluha Zavaley</span>, Lutsk, Ukraine // </span></span><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://unsplash.com/@iluhaza\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">https://unsplash.com/@iluhaza</span></a></span></p>\n\n<p class=\"font_8 wixui-rich-text__text\" style=\"font-size:16px;\"><span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">Photo &copy; <span style=\"font-style:italic;\" class=\"wixui-rich-text__text\">Toa Heftiba</span>, UK // </span></span><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://unsplash.com/@heftiba\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\"><span style=\"font-size:16px;\" class=\"wixui-rich-text__text\">https://unsplash.com/@heftiba</span></a></span></p>","skin":"WRichTextThemeSkin","isQaMode":false,"fullNameCompType":"wysiwyg.viewer.components.WRichText"},"pageBackground_pd6tg":{"fillLayers":{"containerId":"pageBackground_pd6tg","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"backgroundOverlay":{},"shouldPadMedia":false,"hasCanvasAnimation":false},"isMediaPositionOverride":false,"mediaHeightOverrideType":""},"pd6tg":{"className":"theme-vars"},"comp-lsy2a6s5":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lsy2a6s5","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"comp-lsy2a6t9":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]},"fillLayers":{"containerId":"comp-lsy2a6t9","hasBgFullscreenScrollEffect":false,"shouldRenderUnderlay":true,"shouldPadMedia":false,"hasCanvasAnimation":false},"a11y":{"tabindex":"-1"},"dividers":{"hasTopDivider":false,"hasBottomDivider":false},"translations":{"playLabel":"Lecture","pauseLabel":"Mettre en pause"}},"Containerpd6tg":{"meshProps":{"wedges":[],"rotatedComponents":[],"fixedComponents":[]}}}},"__componentsConfig__":{},"accessibilityBrowserZoom":{"isBuilder":false,"isStudio":false},"components":{"componentsUnderFoldMap":{"comp-lsy2a6tc":{"componentType":"wysiwyg.viewer.components.WRichText","compId":"comp-lsy2a6tc"}}},"domSelectors":{"allComponentIds":["comp-lsy2a6st","comp-lsy2a6t5","comp-m2kza88p","comp-lsy2a6tc","pageBackground_pd6tg","pd6tg","comp-lsy2a6s5","comp-lsy2a6t9","Containerpd6tg"]},"imagePlaceholder":{"staticMediaUrl":"https://static.wixstatic.com/media","isSEOBot":false},"landingPage":{"isLandingPage":false},"pageAnchors":{"anchors":[{"dataId":"anchors-lsy2a6sq","compId":"comp-lsy2a6s5","name":"Заголовок страницы